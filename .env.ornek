# Kurum içi OpenAI uyumlu Qwen endpoint'i için ortam değişkenleri.
#
# Bu dosyayı .env olarak kopyala ve kendi değerlerinle doldur:
#   cp .env.ornek .env
#
# .env zaten .gitignore'da — anahtarların depoya girmez.

# Endpoint'in taban adresi. Sonunda /v1 OLMALI, sonda eğik çizgi OLMAMALI.
# Örnekler:
#   vLLM       : http://qwen.kurum.local:8000/v1
#   LiteLLM    : https://llm-gateway.kurum.local/v1
#   Ollama     : http://localhost:11434/v1
OPENAI_API_BASE=https://llm-gateway.kurum.local/v1

# Kurum tarafından verilen API anahtarı. Endpoint anahtar istemiyorsa da
# litellm bir değer bekler; o durumda herhangi bir yer tutucu yaz.
OPENAI_API_KEY=buraya-kurum-anahtarini-yaz

# Endpoint kurum içi sertifika kullanıyorsa ve doğrulama hata veriyorsa, kök
# sertifikanın yolunu ver. Sertifika doğrulamasını tamamen kapatmak yerine
# bunu tercih et.
# SSL_CERT_FILE=/etc/ssl/certs/kurum-ca.pem

# Beceriler için ek arama dizinleri (iki nokta ile ayrılır).
# Varsayılan olarak <proje>/.aider/skills ve ~/.aider/skills zaten taranır.
# AIDER_SKILLS_PATH=/opt/kurum/aider-skills
